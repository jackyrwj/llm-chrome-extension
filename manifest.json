{
  "manifest_version": 3,
  "name": "HF Model Assistant",
  "description": "Hugging Face model page assistant with ModelScope mapping, deployment commands",
  "version": "1.0.6",
  "homepage_url": "https://github.com/jackyrwj/llm-chrome-extension",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://huggingface.co/*",
    "https://www.modelscope.cn/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://huggingface.co/*",
        "https://www.modelscope.cn/*"
      ],
      "js": [
        "src/shared/i18n.js",
        "src/shared/storage.js",
        "src/shared/api.js",
        "src/shared/commands.js",
        "src/content/card.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "src/background/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
